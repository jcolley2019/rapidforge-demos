# 1 lets a build mount webedit-connect.js when framed with ?edit; `npm run deploy -- --edit` sets it, and deploy pins it to 0 otherwise.
VITE_EDIT=
# Comma-separated origins webedit-connect.js accepts; blank means http://localhost:5173/5174 and http://127.0.0.1:5173/5174.
VITE_WEBEDIT_ORIGINS=
# Supabase project URL of the leads app; `npm run intake -- --lead <businessId>` reads businesses and audits from it.
# Also server-side for /api/pick (saves picks to demo_picks); `npm run env:push` copies it to Vercel. Never VITE_-prefixed.
LEADS_SUPABASE_URL=
# The leads project's service-role key. Server-side for /api/pick; `npm run env:push` copies it to Vercel. Never VITE_-prefixed.
LEADS_SUPABASE_SERVICE_ROLE_KEY=
# Resend API key for /api/pick's emails (blank: no email); `npm run env:push` copies it to Vercel; redeploy after a change.
RESEND_API_KEY=
# Where Joey's pick notices go, and the reply-to on the picker's confirmation; `npm run env:push` copies it; redeploy after a change.
PICK_TO_EMAIL=
# Sender of both emails, on a domain verified in Resend (blank: onboarding@resend.dev); `npm run env:push` copies it; redeploy after a change.
PICK_FROM_EMAIL=
