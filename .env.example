# 1 lets a build mount webedit-connect.js when framed with ?edit; `npm run deploy -- --edit` sets it, and deploy pins it to 0 otherwise.
VITE_EDIT=
# Comma-separated origins webedit-connect.js accepts; blank means http://localhost:5173/5174 and http://127.0.0.1:5173/5174.
VITE_WEBEDIT_ORIGINS=
# The leads worker `npm run intake -- --lead <businessId>` pulls the DesignBrief from.
LEADS_API_URL=http://localhost:8788
# Supabase project URL of the leads app, for the password sign-in that yields the worker's Bearer token.
LEADS_SUPABASE_URL=
# That project's anon (public) key, sent as the apikey header on sign-in.
LEADS_SUPABASE_ANON_KEY=
# The leads dashboard login intake signs in as.
LEADS_EMAIL=
# Its password.
LEADS_PASSWORD=
